rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified document paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check test connection rule
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isOwner(userId) {
      return isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // User Root Document & Subcollections
    match /users/{userId} {
      // User can manage their own profile document
      allow read, write: if isOwner(userId);

      // Subjects Subcollection
      // Path: /users/{userId}/subjects/{subjectId}
      match /subjects/{subjectId} {
        allow read, write: if isOwner(userId) && isValidId(subjectId);
      }

      // Timetables Subcollection
      // Path: /users/{userId}/timetables/{timetableId}
      match /timetables/{timetableId} {
        allow read, write: if isOwner(userId) && isValidId(timetableId);
      }

      // Daily Attendance Subcollection
      // Path: /users/{userId}/attendance/{date}
      match /attendance/{date} {
        allow read, write: if isOwner(userId) && isValidId(date);
      }

      // Legacy fallback subcollection for app backwards compatibility
      match /attendance_data/{dataId} {
        allow read, write: if isOwner(userId) && isValidId(dataId);
      }
    }
  }
}


