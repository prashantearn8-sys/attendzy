{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information for authenticated student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "avatar": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Subject definition tracking total and attended classes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "code": { "type": "string", "maxLength": 40 },
        "teacher": { "type": "string", "maxLength": 100 },
        "totalClasses": { "type": "number" },
        "attendedClasses": { "type": "number" },
        "color": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "totalClasses", "attendedClasses"]
    },
    "Timetable": {
      "title": "Timetable",
      "description": "Weekly timetable definition with schedule breakdown per weekday",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "imageUrl": { "type": "string", "maxLength": 2000 },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "weekStart": { "type": "string", "maxLength": 30 },
        "weekEnd": { "type": "string", "maxLength": 30 },
        "days": { "type": "object" }
      },
      "required": ["name", "weekStart", "weekEnd", "days"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily attendance document containing class status list for a specific calendar date",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 30 },
        "classes": { "type": "array" },
        "isDayOff": { "type": "boolean" },
        "dayOffReason": { "type": "string", "maxLength": 200 }
      },
      "required": ["date", "classes"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Student profile document"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Course/subject collection tracking classes and cumulative counts"
    },
    "/users/{userId}/timetables/{timetableId}": {
      "schema": "Timetable",
      "description": "Saved schedules and weekly timetables"
    },
    "/users/{userId}/attendance/{date}": {
      "schema": "AttendanceRecord",
      "description": "Daily attendance slots and statuses"
    }
  }
}

